<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch theme: the native splash only shows the background colour (icon is
         transparent); the animated in-app splash fades in on top, so nothing jumps. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="android:navigationBarColor">#010101</item>
    </style>

    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/app_splash_bg</item>
        <item name="android:navigationBarColor">#010101</item>
    </style>

</resources>
